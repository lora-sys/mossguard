# MossGuard Production Environment Variables
# Copy this file to .env.production and fill in the values.
# DO NOT commit .env.production to git.

# ============================================================
# REQUIRED — these MUST be set in production
# ============================================================

# AI Provider API key (StepFun, OpenAI, or any OpenAI-compatible provider)
OPENAI_API_KEY=your-api-key-here

# Secret for signing user intent hashes (must be at least 16 chars)
# Generate with: openssl rand -hex 32
INTENT_SIGNING_SECRET=replace-with-at-least-16-random-characters

# Secret for wallet handoff (must be at least 16 chars)
# Generate with: openssl rand -hex 32
WALLET_HANDOFF_SECRET=replace-with-at-least-16-random-characters

# ============================================================
# OPTIONAL — defaults are shown, change only if needed
# ============================================================

# AI Provider: "openai" or "stepfun" (auto-detected from base URL if unset)
AI_PROVIDER=openai

# Model name (default: gpt-5-mini)
# For StepFun: step-3.7-flash
AI_MODEL=gpt-5-mini

# OpenAI-compatible base URL (use this for StepFun or other providers)
# OPENAI_BASE_URL=https://api.stepfun.com/step_plan/v1
# Or the StepFun-compatible alias:
# OPEN_BASE_URL=https://api.stepfun.com/step_plan/v1

# AI request timeout in ms (default: 90000)
AI_REQUEST_TIMEOUT_MS=90000

# Moss RPC endpoint (default: Monad mainnet)
MOSS_RPC_URL=https://rpc.monad.xyz

# Monad chain ID (default: 143)
MONAD_CHAIN_ID=143

# Simulation account (test account for Moss simulations)
MOSS_SIMULATION_ACCOUNT=0xcccccccccccccccccccccccccccccccccccccccc

# Demo injection scenarios (default: true — enables A/B demo blocks)
DEMO_SCENARIOS_ENABLED=true

# Wallet handoff feature (default: false)
ENABLE_WALLET_HANDOFF=false

# Moss pipeline timeout in ms (default: 45000)
MOSS_PIPELINE_TIMEOUT_MS=45000

# Raw evidence TTL in ms (default: 1800000 = 30 min)
MOSS_RAW_EVIDENCE_TTL_MS=1800000

# Max evidence records to keep (default: 20)
MOSS_MAX_EVIDENCE_RECORDS=20

# WalletConnect Project ID (for wallet connection)
WALLET_CONNECT_PROJECT_ID=
